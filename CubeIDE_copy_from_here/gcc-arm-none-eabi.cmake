set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

set(TOOLCHAIN_PREFIX    arm-none-eabi-)
set(CMAKE_C_COMPILER    ${TOOLCHAIN_PREFIX}gcc)
set(CMAKE_ASM_COMPILER  ${CMAKE_C_COMPILER})
set(CMAKE_CXX_COMPILER  ${TOOLCHAIN_PREFIX}g++)
set(CMAKE_LINKER        ${TOOLCHAIN_PREFIX}g++)
set(CMAKE_OBJCOPY       ${TOOLCHAIN_PREFIX}objcopy)
set(CMAKE_SIZE          ${TOOLCHAIN_PREFIX}size)

set(CMAKE_EXECUTABLE_SUFFIX_ASM ".elf")
set(CMAKE_EXECUTABLE_SUFFIX_C   ".elf")
set(CMAKE_EXECUTABLE_SUFFIX_CXX ".elf")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)


# MCU: STM32H723VGT6

# MCU_FAMILY: STM32H7xx
string(SUBSTRING "${MCU}" 0 7 MCU_FAMILY)
set(MCU_FAMILY "${MCU_FAMILY}xx")

# MCU_SUBFAMILY: STM32H723xx
string(SUBSTRING "${MCU}" 0 9 MCU_SUBFAMILY)
set(MCU_SUBFAMILY "${MCU_SUBFAMILY}xx")

# MCU_VARIANT: STM32H723VGTX
string(REGEX REPLACE ".$" "X" MCU_VARIANT "${MCU}")


set(TOOLCHAIN_FLAGS "${MCU_ARCH_FLAGS} -fdata-sections -ffunction-sections -fstack-usage")
set(TOOLCHAIN_FLAGS_DEBUG "-O0 -g3 -ggdb -DDEBUG")
set(TOOLCHAIN_FLAGS_RELEASE "-Os -g0 -DNDEBUG")

set(TOOLCHAIN_LINK_FLAGS "-T \"${CMAKE_SOURCE_DIR}/CubeIDE/${MCU_VARIANT}_FLASH.ld\"")
set(TOOLCHAIN_LINK_FLAGS "${TOOLCHAIN_LINK_FLAGS} -Wl,-Map=${CMAKE_PROJECT_NAME}.map -Wl,--gc-sections")
set(TOOLCHAIN_LINK_FLAGS "${TOOLCHAIN_LINK_FLAGS} -static")
set(TOOLCHAIN_LINK_FLAGS "${TOOLCHAIN_LINK_FLAGS} -Wl,--start-group -lc -lm -Wl,--end-group")
set(TOOLCHAIN_LINK_FLAGS "${TOOLCHAIN_LINK_FLAGS} -Wl,--print-memory-usage")

set(CMAKE_C_FLAGS "${TOOLCHAIN_FLAGS}")
set(CMAKE_C_FLAGS_DEBUG "${TOOLCHAIN_FLAGS_DEBUG}")
set(CMAKE_C_FLAGS_RELEASE "${TOOLCHAIN_FLAGS_RELEASE}")

set(CMAKE_ASM_FLAGS "${TOOLCHAIN_FLAGS} -x assembler-with-cpp")
set(CMAKE_ASM_FLAGS_DEBUG "${TOOLCHAIN_FLAGS_DEBUG}")
set(CMAKE_ASM_FLAGS_RELEASE "${TOOLCHAIN_FLAGS_RELEASE}")

set(CMAKE_CXX_FLAGS "${TOOLCHAIN_FLAGS} -fno-rtti -fno-exceptions -fno-threadsafe-statics -fno-use-cxa-atexit")
set(CMAKE_CXX_FLAGS_DEBUG "${TOOLCHAIN_FLAGS_DEBUG}")
set(CMAKE_CXX_FLAGS_RELEASE "${TOOLCHAIN_FLAGS_RELEASE}")

set(CMAKE_C_LINK_FLAGS "${TOOLCHAIN_LINK_FLAGS}")
set(CMAKE_CXX_LINK_FLAGS "${TOOLCHAIN_LINK_FLAGS} -Wl,--start-group -lstdc++ -lsupc++ -Wl,--end-group")

set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
